# Interface
theme[main_bg]="#{base00}"
theme[main_fg]="#{base05}"
theme[title]="#{base0D}"
theme[hi_fg]="#{base0C}"
theme[selected_bg]="#{base02}"
theme[selected_fg]="#{base05}"
theme[inactive_fg]="#{base04}"
theme[graph_text]="#{base05}"
theme[meter_bg]="#{base02}"
theme[proc_misc]="#{base0C}"

# Borders
theme[cpu_box]="#{base03}"
theme[mem_box]="#{base03}"
theme[net_box]="#{base03}"
theme[proc_box]="#{base03}"
theme[div_line]="#{base03}"

# Temperature and CPU usage
theme[temp_start]="#{base0B}"
theme[temp_mid]="#{base0A}"
theme[temp_end]="#{base08}"
theme[cpu_start]="#{base0B}"
theme[cpu_mid]="#{base0A}"
theme[cpu_end]="#{base08}"

# Memory and disk meters
theme[free_start]="#{base08}"
theme[free_mid]="#{base0A}"
theme[free_end]="#{base0B}"
theme[cached_start]="#{base0D}"
theme[cached_mid]="#{base0C}"
theme[cached_end]="#{base0B}"
theme[available_start]="#{base08}"
theme[available_mid]="#{base0A}"
theme[available_end]="#{base0B}"
theme[used_start]="#{base0B}"
theme[used_mid]="#{base0A}"
theme[used_end]="#{base08}"

# Network traffic
theme[download_start]="#{base0B}"
theme[download_mid]="#{base0C}"
theme[download_end]="#{base0D}"
theme[upload_start]="#{base0D}"
theme[upload_mid]="#{mix(base0D, base0E, 0.5)}"
theme[upload_end]="#{base0E}"

# Process usage
theme[process_start]="#{base0B}"
theme[process_mid]="#{base0A}"
theme[process_end]="#{base08}"
