{{
  "base": {{
    "categorical": [
      "purple",
      "blue",
      "cyan",
      "orange",
      "red"
    ],
    "text": {{
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {{
        "primary": {{
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "#{base00}",
          "$selected": "#{base0C}"
        }},
        "secondary": {{
          "base": "$text.muted",
          "$hovered": "$text.base"
        }},
        "destructive": {{
          "base": "#{base00}",
          "$disabled": "$text.muted"
        }}
      }},
      "formfield": {{
        "base": "$text.base",
        "$hovered": "#{base0C}",
        "$focused": "$text.base",
        "$pressed": "#{base0C}",
        "$disabled": "$text.muted",
        "$selected": "#{base0C}"
      }},
      "feedback": {{
        "error": {{
          "base": "$hue.red.200"
        }},
        "warning": {{
          "base": "$hue.orange.200"
        }},
        "success": {{
          "base": "$hue.green.200"
        }},
        "info": {{
          "base": "$hue.blue.200"
        }}
      }}
    }},
    "background": {{
      "base": "$hue.neutral.800",
      "raised": {{
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      }},
      "action": {{
        "primary": {{
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "#{base0C}",
          "$selected": "transparent"
        }},
        "secondary": {{
          "base": "transparent"
        }},
        "destructive": {{
          "base": "#{base08}"
        }}
      }},
      "formfield": {{
        "base": "$background.base",
        "$focused": "#{base02}"
      }},
      "feedback": {{
        "error": {{
          "base": "$background.base"
        }},
        "warning": {{
          "base": "$background.base"
        }},
        "success": {{
          "base": "$background.base"
        }},
        "info": {{
          "base": "$background.base"
        }}
      }}
    }},
    "border": {{
      "base": "#{base03}"
    }},
    "scrollbar": {{
      "base": "#{base0D}"
    }},
    "diff": {{
      "text": {{
        "added": "#{base0B}",
        "removed": "#{base08}",
        "context": "#{base04}",
        "hunkHeader": "#{base04}"
      }},
      "background": {{
        "added": "#{mix(base00, base0B, 0.22)}",
        "removed": "#{mix(base00, base08, 0.22)}",
        "context": "#{base01}"
      }},
      "highlight": {{
        "added": "#{base0B}",
        "removed": "#{base08}"
      }},
      "lineNumber": {{
        "text": "#{base04}",
        "background": {{
          "added": "#{mix(base01, base0B, 0.22)}",
          "removed": "#{mix(base01, base08, 0.22)}"
        }}
      }}
    }},
    "markdown": {{
      "text": "#{base05}",
      "heading": "#{base09}",
      "link": "#{base0D}",
      "linkText": "#{base0C}",
      "code": "#{base0A}",
      "blockQuote": "#{base04}",
      "emphasis": "#{base0A}",
      "strong": "#{base09}",
      "horizontalRule": "#{base03}",
      "listItem": "#{base0C}",
      "listEnumeration": "#{base0C}",
      "image": "#{base0D}",
      "imageText": "#{base0C}",
      "codeBlock": "#{base05}"
    }},
    "syntax": {{
      "comment": "#{base03}",
      "keyword": "#{base0E}",
      "function": "#{base0D}",
      "variable": "#{base05}",
      "string": "#{base0B}",
      "number": "#{base09}",
      "type": "#{base0A}",
      "operator": "#{base05}",
      "punctuation": "#{base05}"
    }},
    "@dialog": {{
      "background": {{
        "base": "$background.raised.base",
        "action": {{
          "primary": {{
            "$hovered": "$background.raised.high"
          }}
        }}
      }}
    }}
  }},
  "dark": {{
    "hue": {{
      "gray": {{
        "100": "#{base06}",
        "200": "#{base05}",
        "300": "#{mix(base05, base04, 0.5)}",
        "400": "#{base04}",
        "500": "#{mix(base04, base02, 0.5)}",
        "600": "#{base02}",
        "700": "#{base01}",
        "800": "#{base00}",
        "900": "#{base00}"
      }},
      "red": {{
        "100": "#{mix(base08, base07, 0.25)}",
        "200": "#{base08}",
        "300": "#{mix(base08, base00, 0.16)}",
        "400": "#{mix(base08, base00, 0.32)}",
        "500": "#{mix(base08, base00, 0.47)}",
        "600": "#{mix(base08, base00, 0.62)}",
        "700": "#{mix(base08, base00, 0.74)}",
        "800": "#{mix(base08, base00, 0.88)}",
        "900": "#{mix(base08, base00, 0.97)}"
      }},
      "orange": {{
        "100": "#{mix(base09, base07, 0.25)}",
        "200": "#{base09}",
        "300": "#{mix(base09, base00, 0.16)}",
        "400": "#{mix(base09, base00, 0.32)}",
        "500": "#{mix(base09, base00, 0.47)}",
        "600": "#{mix(base09, base00, 0.62)}",
        "700": "#{mix(base09, base00, 0.74)}",
        "800": "#{mix(base09, base00, 0.88)}",
        "900": "#{mix(base09, base00, 0.97)}"
      }},
      "yellow": {{
        "100": "#{mix(base0A, base07, 0.25)}",
        "200": "#{base0A}",
        "300": "#{mix(base0A, base00, 0.16)}",
        "400": "#{mix(base0A, base00, 0.32)}",
        "500": "#{mix(base0A, base00, 0.47)}",
        "600": "#{mix(base0A, base00, 0.62)}",
        "700": "#{mix(base0A, base00, 0.74)}",
        "800": "#{mix(base0A, base00, 0.88)}",
        "900": "#{mix(base0A, base00, 0.97)}"
      }},
      "green": {{
        "100": "#{mix(base0B, base07, 0.25)}",
        "200": "#{base0B}",
        "300": "#{mix(base0B, base00, 0.16)}",
        "400": "#{mix(base0B, base00, 0.32)}",
        "500": "#{mix(base0B, base00, 0.47)}",
        "600": "#{mix(base0B, base00, 0.62)}",
        "700": "#{mix(base0B, base00, 0.74)}",
        "800": "#{mix(base0B, base00, 0.88)}",
        "900": "#{mix(base0B, base00, 0.97)}"
      }},
      "cyan": {{
        "100": "#{mix(base0C, base07, 0.25)}",
        "200": "#{base0C}",
        "300": "#{mix(base0C, base00, 0.16)}",
        "400": "#{mix(base0C, base00, 0.32)}",
        "500": "#{mix(base0C, base00, 0.47)}",
        "600": "#{mix(base0C, base00, 0.62)}",
        "700": "#{mix(base0C, base00, 0.74)}",
        "800": "#{mix(base0C, base00, 0.88)}",
        "900": "#{mix(base0C, base00, 0.97)}"
      }},
      "blue": {{
        "100": "#{mix(base0D, base07, 0.25)}",
        "200": "#{base0D}",
        "300": "#{mix(base0D, base00, 0.16)}",
        "400": "#{mix(base0D, base00, 0.32)}",
        "500": "#{mix(base0D, base00, 0.47)}",
        "600": "#{mix(base0D, base00, 0.62)}",
        "700": "#{mix(base0D, base00, 0.74)}",
        "800": "#{mix(base0D, base00, 0.88)}",
        "900": "#{mix(base0D, base00, 0.97)}"
      }},
      "purple": {{
        "100": "#{mix(base0E, base07, 0.25)}",
        "200": "#{base0E}",
        "300": "#{mix(base0E, base00, 0.16)}",
        "400": "#{mix(base0E, base00, 0.32)}",
        "500": "#{mix(base0E, base00, 0.47)}",
        "600": "#{mix(base0E, base00, 0.62)}",
        "700": "#{mix(base0E, base00, 0.74)}",
        "800": "#{mix(base0E, base00, 0.88)}",
        "900": "#{mix(base0E, base00, 0.97)}"
      }},
      "accent": "$hue.blue",
      "interactive": "$hue.cyan",
      "neutral": "$hue.gray"
    }}
  }}
}}
