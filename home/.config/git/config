[credential]
    helper = store
    username = dangooddd

[user]
    email = dangoodds@gmail.com
    name = dangooddd

[alias]
    dt = difftool --dir-diff

[init]
    defaultBranch = main

[diff]
    tool = nvimdiff

[difftool]
    prompt = true
    trustExitCode = true

[difftool "nvimdiff"]
    cmd = "if [ -n \"$NVIM\" ]; then \
        nvim -l \"$HOME/.config/nvim/lua/diff.lua\" \"$LOCAL\" \"$REMOTE\"; \
    else \
        nvim -d -- \"$LOCAL\" \"$REMOTE\"; \
    fi"

[merge]
    tool = nvimdiff

[mergetool "nvimdiff"]
    layout = "LOCAL,REMOTE / MERGED"

[mergetool]
    prompt = true
    hideResolved = true
    keepBackup = false

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[safe]
	directory = *
