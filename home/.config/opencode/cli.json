{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "session.background": "<leader>b"
  },
  "theme": {
    "name": "jungle"
  },
  "scroll": {
    "speed": 1
  },
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "session": {
    "permissions": "autoaccept",
    "scrollbar": true
  },
  "prompt": {
    "image_preview": true
  }
}
