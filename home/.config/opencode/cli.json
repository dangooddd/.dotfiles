{
  "$schema": "https://opencode.ai/v2/cli.json",
  "keybinds": {
    "session.background": "<leader>b",
    "session.new": "<leader>c",
    "session.tab.close": "<leader>x",
    "session.export": "<leader>e",
    "session.compact": "<leader>w",
    "prompt.editor": "<leader>n"
  },
  "theme": {
    "name": "jungle"
  },
  "scroll": {
    "speed": 1
  },
  "cursor": {
    "style": "block",
    "blinking": false
  },
  "session": {
    "permissions": "autoaccept",
    "scrollbar": true
  },
  "prompt": {
    "image_preview": true
  }
}
