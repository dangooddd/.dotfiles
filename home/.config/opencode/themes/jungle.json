{
  "base": {
    "categorical": [
      "purple",
      "blue",
      "cyan",
      "orange",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$text.muted",
          "$focused": "#131914",
          "$selected": "#63AFA0"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "#131914",
          "$disabled": "$text.muted"
        }
      },
      "formfield": {
        "base": "$text.base",
        "$hovered": "#63AFA0",
        "$focused": "$text.base",
        "$pressed": "#63AFA0",
        "$disabled": "$text.muted",
        "$selected": "#63AFA0"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "$hue.orange.200"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.blue.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$background.raised.base",
          "$focused": "#63AFA0",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "#DF867A"
        }
      },
      "formfield": {
        "base": "$background.base",
        "$focused": "#2D382E"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#556753"
    },
    "scrollbar": {
      "base": "#97BACC"
    },
    "diff": {
      "text": {
        "added": "#84B87E",
        "removed": "#DF867A",
        "context": "#87967F",
        "hunkHeader": "#87967F"
      },
      "background": {
        "added": "#2C3C2B",
        "removed": "#40312A",
        "context": "#1D261F"
      },
      "highlight": {
        "added": "#84B87E",
        "removed": "#DF867A"
      },
      "lineNumber": {
        "text": "#87967F",
        "background": {
          "added": "#344634",
          "removed": "#483B33"
        }
      }
    },
    "markdown": {
      "text": "#D4DCC2",
      "heading": "#EDA665",
      "link": "#97BACC",
      "linkText": "#63AFA0",
      "code": "#DAC05B",
      "blockQuote": "#87967F",
      "emphasis": "#DAC05B",
      "strong": "#EDA665",
      "horizontalRule": "#556753",
      "listItem": "#63AFA0",
      "listEnumeration": "#63AFA0",
      "image": "#97BACC",
      "imageText": "#63AFA0",
      "codeBlock": "#D4DCC2"
    },
    "syntax": {
      "comment": "#556753",
      "keyword": "#B89CC1",
      "function": "#97BACC",
      "variable": "#D4DCC2",
      "string": "#84B87E",
      "number": "#EDA665",
      "type": "#DAC05B",
      "operator": "#D4DCC2",
      "punctuation": "#D4DCC2"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#E7EED3",
        "200": "#D4DCC2",
        "300": "#AEB9A1",
        "400": "#87967F",
        "500": "#5A6757",
        "600": "#2D382E",
        "700": "#1D261F",
        "800": "#131914",
        "900": "#131914"
      },
      "red": {
